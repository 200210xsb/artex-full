# Docker 部署配置（复制为 .env）

# ── 端口 ────────────────────────────────────────
# 宿主机端口被占用时改这里；右边（容器内端口）不要动。
ARTEX_PORT=8787

# ── PostgreSQL ──────────────────────────────────
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# ── LLM（二选一或都填；也可留空到 UI 里配）──────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# ── 回连监听（OOB）──────────────────────────────
# OOB_PUBLIC_HOST 是目标要访问的公网地址，留空则「功能 → 回连监听」收不到任何数据。
OOB_PUBLIC_HOST=
# 三个监听端口都要在安全组/防火墙放行；被占用时改成别的。
OOB_PORT_1=8889
OOB_PORT_2=18666
OOB_PORT_3=18667
OOB_PORTS=8889,18666,18667
OOB_RETENTION_DAYS=7
