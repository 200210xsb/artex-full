# OOB（回连带外信道）配置模板
#
# 复制成 oob.conf 后按实际环境改。改完重启 oob-listen 生效。
# 环境变量优先级高于本文件，容器部署可以直接用 env 覆盖。

# 【必填】回连方应该访问的公网地址。
# 这是整个功能能不能用的关键：如果填成 NAT 内网地址（10.x / 192.168.x），
# 目标发出的请求会打到一个它无法到达的地方，页面永远收不到回连。
# 云主机填弹性公网 IP；没有公网 IP 时填能映射到本机的域名。
OOB_PUBLIC_HOST=

# 监听端口，逗号分隔。多开几个端口是为了绕过只放行少数出站端口的场景
# （比如目标只允许访问 80/443/8080 时，换一个它能出去的端口）。
OOB_PORTS=8889,18666,18667

# 命中库路径。ARTEX 页面（server/oob.go）读的是同一个文件，
# 所以这个值必须和 ARTEX 那边的 OOB_DB / OOB_DATA_DIR 对得上。
OOB_DB=/opt/artex/data/oob/oob.db

# 日志路径。容器部署建议改成 /dev/stderr，交给 docker logs 收。
OOB_LOG=/var/log/oob-mcp.log

# 命中保留天数，超期的在下次写入时清掉。
OOB_RETENTION_DAYS=7

# 是否把监听器自身产生的探测请求也记进库（调试用，默认关）。
OOB_RECORD_NOISE=0
